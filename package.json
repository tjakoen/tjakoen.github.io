{
  "name": "tjakoen.github.io",
  "version": "0.1.0",
  "description": "tjakoen.github.io — a custom BATCH + GRAIN site that uses MILL for its content.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "author": "Tjakoen Stolk <tjakoen.s@gmail.com> (https://portfolio.tjakoen.com)",
  "homepage": "https://portfolio.tjakoen.com",
  "dependencies": {
    "@tjakoen/batch": "^0.3.0",
    "@tjakoen/crumb": "^0.1.10",
    "@tjakoen/grain": "^0.1.33",
    "@tjakoen/mill": "^0.4.2",
    "@tjakoen/proof": "^0.1.5",
    "highlight.js": "^11.12.0"
  },
  "scripts": {
    "deps:refresh": "bun update @tjakoen/batch @tjakoen/crumb @tjakoen/grain @tjakoen/mill @tjakoen/proof",
    "dev": "DESK_CLIENT=1 bun --hot src/server.ts",
    "dev:stub": "STUB_DESK=1 bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "test:e2e": "playwright test",
    "e2e:local": "bash tools/e2e-local.sh",
    "test:all": "bun test && playwright test",
    "shots": "bun tools/screenshots.ts",
    "og:card": "bun tools/og-card.ts",
    "social:card": "bun tools/social-card.ts",
    "social:card:dashboards": "bun tools/social-card-dashboards.ts",
    "social:card:reviewer": "bun tools/social-card-reviewer.ts",
    "social:card:epic": "bun tools/social-card-epic.ts",
    "social:card:orchestration": "bun tools/social-card-orchestration.ts",
    "audit": "bun tools/audit.ts",
    "lint:voice": "bun tools/voice-lint.ts",
    "lint:links": "bun tools/link-lint.ts",
    "lint:baseline": "bun tools/lint-gate.ts --write",
    "answers:check": "bun tools/answers-check.ts",
    "audit:desk": "bun tools/desk-audit.ts",
    "analytics:pull": "bun tools/analytics-pull.ts",
    "dream": "bun tools/dream.ts",
    "diagrams:warm": "bun tools/diagram-warm.ts",
    "diagrams:check": "bun tools/diagram-cache-gate.ts",
    "export": "bun tools/export.ts",
    "verify:export": "bun tools/verify-export.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.61.1",
    "bun-types": "^1.3.14",
    "mermaid": "^11.17.0",
    "oxlint": "1.77.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    "./docs/*": "./docs/*",
    "./standards/*": "./standards/*"
  }
}
